# =============================================================================
# VCCad - .gitignore
# Standard ignores for .NET / Avalonia / Docker / editor artifacts.
# =============================================================================

# --- .NET build output -------------------------------------------------------
bin/
obj/
artifacts/
*.user
*.suo
*.userosscache
*.sln.docstates
*.bts
*.tlb
*.tlb.dSYM

# NuGet
*.nupkg
*.snupkg
packages/
*.nuget.props
*.nuget.targets

# IDEs
.idea/
.vs/
.vscode/
.ionide/

# Avalonia browser publish output
wwwroot/
**/publish/
!src/VCCad.App.Browser/wwwroot/
!src/VCCad.App.Browser/wwwroot/**

# Test results
TestResults/
*.trx
coverage/
*.coverage

# Python tooling
__pycache__/
*.pyc

# OS noise
.DS_Store
Thumbs.db

# Logs / secrets (never commit)
*.log
.env
.env.*
!.env.example
*.pfx
*.key
secrets/

# The copyrighted sample PDFs live in a private repository and are checked out beside this one.
# Ignored here so they cannot be added back by accident.
samples/

# Machine-local settings: the model endpoint, its key, and anything else that is a deployment value.
# An endpoint and a key are not source, and a repository that ships them ships a secret.
settings.json
