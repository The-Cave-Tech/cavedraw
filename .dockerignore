# =============================================================================
# VCCad - .dockerignore
# Keep the build context lean; obj/bin are rebuilt inside the image anyway.
# NOTE: do NOT add a bare `wwwroot/` pattern — the browser host's static files
# (src/VCCad.App.Browser/wwwroot) are required in the build context.
# =============================================================================

**/bin/
**/obj/
.git
.github
.vs
.idea
.vscode
artifacts
TestResults
*.log
*.trx
coverage
**/publish/
docker-compose.yml
docker/.env
