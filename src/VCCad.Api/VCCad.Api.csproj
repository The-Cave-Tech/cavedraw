<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>VCCad.Api</AssemblyName>
    <RootNamespace>VCCad.Api</RootNamespace>
    <Description>VCCad automation host: REST document lifecycle + JSON-RPC 2.0 over WebSocket; serves the Avalonia WASM editor.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Http.HttpResults" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VCCad.Core\VCCad.Core.csproj" />
    <ProjectReference Include="..\VCCad.Pdf\VCCad.Pdf.csproj" />
  </ItemGroup>

</Project>
