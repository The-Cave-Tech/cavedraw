<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:VCCad.App.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1280" d:DesignHeight="820"
             x:Class="VCCad.App.Views.EditorView"
             Name="Root"
             Background="{DynamicResource VcBackground}">

  <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource VcBackground}">

    <!-- Menu strip (Windows menu is populated in code) -->
    <Menu Grid.Row="0">
      <MenuItem Header="_File">
        <MenuItem Header="_New" Click="OnNew"/>
        <MenuItem Header="New _Artboard" Click="OnNewArtboard"/>
        <!-- We standardise on PDF, so this is Open, not Import: there is no other
             format to import from. -->
        <MenuItem Header="_Open…" Click="OnImportPdf" InputGesture="Ctrl+O"/>
        <MenuItem Name="OpenRecentMenu" Header="Open _Recent">
          <MenuItem Header="(nothing yet)" IsEnabled="False"/>
        </MenuItem>
        <MenuItem Header="_Close" Click="OnCloseDocument" InputGesture="Ctrl+W"/>
        <Separator/>
        <MenuItem Header="_Open from Server…" Click="OnOpen"/>
        <MenuItem Header="_Save to Server" Click="OnSave" InputGesture="Ctrl+S"/>
        <Separator/>
        <MenuItem Header="_Export PDF…" Click="OnExportPdf"/>
        <Separator/>
        <MenuItem Header="E_xit" Click="OnExit"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Click="OnUndo"/>
        <MenuItem Header="_Redo" Click="OnRedo"/>
        <Separator/>
        <MenuItem Header="_Delete" Click="OnDelete"/>
        <Separator/>
        <MenuItem Header="_Group" Click="OnGroup"/>
        <MenuItem Header="_Ungroup" Click="OnUngroup"/>
        <Separator/>
        <MenuItem Header="Flip _Horizontal" Click="OnFlipHorizontal"/>
        <MenuItem Header="Flip _Vertical" Click="OnFlipVertical"/>
        <Separator/>
        <MenuItem Header="Close _Path" Click="OnClosePath"/>
        <MenuItem Header="_Join Paths" Click="OnJoinPaths"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Zoom In" Click="OnZoomIn"/>
        <MenuItem Header="Zoom _Out" Click="OnZoomOut"/>
        <MenuItem Header="_Actual Size" Click="OnActualSize"/>
        <MenuItem Header="_Fit in Window" Click="OnFitInWindow"/>
      </MenuItem>
      <MenuItem Header="_Windows" Name="WindowsMenu"/>
    </Menu>

    <!-- Docking area.
         Columns: [left toolbars][left panels][split][canvas][split][right panels][right toolbars]
         Toolbar zones are fixed width; panel columns are scalable via splitters. -->
    <Grid Grid.Row="1" Name="DockArea"
          ColumnDefinitions="Auto,240,4,*,4,272,Auto" RowDefinitions="Auto,*,Auto">
      <!-- Horizontal toolbars span the full row -->
      <StackPanel Name="TopHost" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="7" Orientation="Vertical"/>

      <StackPanel Name="LeftToolbarHost" Grid.Row="1" Grid.Column="0" Orientation="Vertical"/>
      <!-- Panel hosts are grids: stacked panels are sized rows with a draggable
             separator between neighbours, so a person can make a panel taller or
             shorter. -->
      <Grid Name="LeftPanelHost" Grid.Row="1" Grid.Column="1" MinWidth="120"/>
      <GridSplitter Name="LeftSplitter" Grid.Row="1" Grid.Column="2"
                    ResizeDirection="Columns" Background="{DynamicResource VcBorder}"
                    HorizontalAlignment="Stretch"/>
      <Border Grid.Row="1" Grid.Column="3" Background="{DynamicResource VcBackground}">
        <DockPanel>
          <!-- Document tabs (MDI): one tab per open document -->
          <Border DockPanel.Dock="Top" Background="{DynamicResource VcPanelAlt}"
                  BorderBrush="{DynamicResource VcBorder}" BorderThickness="0,0,0,1" Padding="4,2">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ItemsControl Name="DocTabsHost">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="2"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <Button Name="NewTabButton" Content="+" Click="OnNewTab" ToolTip.Tip="New document"/>
            </StackPanel>
          </Border>

          <!-- Text toolbar: only while a text block is being edited, so the controls a
               person needs to set type are in front of them at the moment they need
               them. Every control here is reachable through ui.find/ui.setValue, so a
               driver can click the same buttons a person does. -->
          <Border Name="TextToolbar" DockPanel.Dock="Top" IsVisible="False"
                  Background="{DynamicResource VcPanel}" BorderBrush="{DynamicResource VcBorder}"
                  BorderThickness="0,0,0,1" Padding="6,4">
            <Border.Styles>
              <!-- The numeric fields sit centred in their own height with the value
                   centred too. Small, top-left-justified boxes read as broken: the number
                   floats in the corner of a box that is taller than it needs to be. -->
              <Style Selector="TextBox.TtNumber">
                <Setter Property="Width" Value="58"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="MinHeight" Value="28"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="6,0"/>
              </Style>
              <Style Selector="TextBlock.TtLabel">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{DynamicResource VcTextDim}"/>
                <Setter Property="FontSize" Value="12"/>
              </Style>
            </Border.Styles>

            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Classes="TtLabel" Text="Text" FontWeight="SemiBold"/>
              <ComboBox Name="TtFont" Width="180" Height="28" VerticalContentAlignment="Center"
                        ToolTip.Tip="Font — hover to preview, click to apply">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <!-- Each entry is drawn in its own face, so the list shows what it
                         offers instead of naming it and leaving you to imagine. The label
                         carries the number of faces the family has, and a family nothing can
                         draw says so rather than quietly rendering in the default - which
                         would look exactly like a row that worked. -->
                    <TextBlock Text="{Binding Label}" FontFamily="{Binding Face}" FontSize="15"
                               VerticalAlignment="Center" Padding="0,2"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBox Name="TtSize" Classes="TtNumber" ToolTip.Tip="Size in points"/>
              <ToggleButton Name="TtBold" Content="B" FontWeight="Bold" Width="32" Height="28"
                            ToolTip.Tip="Bold"/>
              <ToggleButton Name="TtItalic" Content="I" FontStyle="Italic" Width="32" Height="28"
                            ToolTip.Tip="Italic"/>
              <ComboBox Name="TtAlign" Width="100" Height="28" VerticalContentAlignment="Center"
                        ToolTip.Tip="Alignment">
                <ComboBoxItem Content="Left"/>
                <ComboBoxItem Content="Center"/>
                <ComboBoxItem Content="Right"/>
              </ComboBox>
              <TextBlock Classes="TtLabel" Text="Leading"/>
              <TextBox Name="TtLineSpacing" Classes="TtNumber"
                       ToolTip.Tip="Line spacing (multiple of the font size)"/>
              <TextBlock Classes="TtLabel" Text="Space"/>
              <TextBox Name="TtParagraphSpacing" Classes="TtNumber"
                       ToolTip.Tip="Space between paragraphs"/>
              <TextBlock Classes="TtLabel" Text="Rot"/>
              <TextBox Name="TtRotation" Classes="TtNumber" ToolTip.Tip="Rotation in degrees"/>
              <TextBlock Classes="TtLabel" Text="Colour"/>
              <TextBox Name="TtColor" Width="92" Height="28" VerticalContentAlignment="Center"
                       HorizontalContentAlignment="Center" FontSize="13" Padding="6,0"
                       ToolTip.Tip="Colour as R,G,B"/>
              <Button Name="TtWidth" Content="Box…" Height="28" ToolTip.Tip="Set the frame width the text wraps in"/>
            </StackPanel>
          </Border>

          <controls:CanvasWorkspace x:Name="Workspace" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </DockPanel>
      </Border>
      <GridSplitter Name="RightSplitter" Grid.Row="1" Grid.Column="4"
                    ResizeDirection="Columns" Background="{DynamicResource VcBorder}"
                    HorizontalAlignment="Stretch"/>
      <Grid Name="RightPanelHost" Grid.Row="1" Grid.Column="5" MinWidth="120"/>
      <StackPanel Name="RightToolbarHost" Grid.Row="1" Grid.Column="6" Orientation="Vertical"/>

      <StackPanel Name="BottomHost" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7" Orientation="Vertical"/>

      <!-- Drop-zone highlight while dragging a panel/toolbar -->
      <Canvas Name="DropOverlay" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="7"
              IsHitTestVisible="False">
        <Border Name="DropLeft" Background="#552B4C7E" BorderBrush="#4C9AFF" BorderThickness="2" IsVisible="False"/>
        <Border Name="DropRight" Background="#552B4C7E" BorderBrush="#4C9AFF" BorderThickness="2" IsVisible="False"/>
        <Border Name="DropTop" Background="#552B4C7E" BorderBrush="#4C9AFF" BorderThickness="2" IsVisible="False"/>
        <Border Name="DropBottom" Background="#552B4C7E" BorderBrush="#4C9AFF" BorderThickness="2" IsVisible="False"/>
      </Canvas>
    </Grid>

    <!-- Modal prompt overlay (in-app so it works in the browser) -->
    <Grid Name="ModalOverlay" Grid.Row="0" Grid.RowSpan="3" IsVisible="False"
          Background="#99000000">
      <Border Background="{DynamicResource VcPanel}" BorderBrush="{DynamicResource VcBorder}"
              BorderThickness="1" CornerRadius="8" Padding="18" MaxWidth="420"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Name="ModalMessage" TextWrapping="Wrap"
                     Foreground="{DynamicResource VcText}"/>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Keep objects" Click="OnDeleteKeepObjects"/>
            <Button Content="Delete objects" Click="OnDeleteAllObjects"/>
            <Button Content="Cancel" Click="OnDeleteCancel"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Shown when the document names standard fonts this computer cannot supply.
         A PDF is entitled to name Helvetica and embed nothing, so the face has to come
         from somewhere; we ask before fetching it rather than shipping fonts we may not
         redistribute or silently substituting a different design. -->
    <Grid Name="FontOverlay" Grid.Row="0" Grid.RowSpan="3" IsVisible="False"
          Background="#99000000">
      <Border Background="{DynamicResource VcPanel}" BorderBrush="{DynamicResource VcBorder}"
              BorderThickness="1" CornerRadius="8" Padding="20" MaxWidth="500"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Text="This document needs fonts that are not installed"
                     FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"
                     Foreground="{DynamicResource VcText}"/>
          <TextBlock Name="FontOverlayMessage" TextWrapping="Wrap"
                     Foreground="{DynamicResource VcText}"/>
          <Border Background="{DynamicResource VcPanelAlt}" CornerRadius="4" Padding="10">
            <TextBlock Name="FontOverlayDetail" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource VcTextDim}"/>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Name="FontInstallAgree" Content="I agree — install now"
                    Click="OnFontInstallAgree"/>
            <Button Name="FontInstallLater" Content="Not now"
                    Click="OnFontInstallLater"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Asking before throwing work away. Closing a document or quitting with unsaved
         changes is the one place an editor must stop and ask. -->
    <!-- Covers the editing area rather than the whole window: a prompt the person is not
         ready to answer must not take the File menu with it. -->
    <Grid Name="ConfirmOverlay" Grid.Row="1" IsVisible="False" Background="#99000000">
      <Border Background="{DynamicResource VcPanel}" BorderBrush="{DynamicResource VcBorder}"
              BorderThickness="1" CornerRadius="8" Padding="20" MaxWidth="460"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Name="ConfirmTitle" Text="Save changes?"
                     FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"
                     Foreground="{DynamicResource VcText}"/>
          <TextBlock Name="ConfirmMessage" TextWrapping="Wrap"
                     Foreground="{DynamicResource VcText}"/>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Name="ConfirmSave" Content="Save" Click="OnConfirmSave"/>
            <Button Name="ConfirmDiscard" Content="Discard" Click="OnConfirmDiscard"/>
            <Button Name="ConfirmCancel" Content="Cancel" Click="OnConfirmCancel"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Classes="statusBar">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" x:Name="ZoomLabel" Text="100%"
                   Foreground="{DynamicResource VcTextDim}" Margin="10,0"/>
        <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource VcText}"
                   TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>

  </Grid>
</UserControl>
