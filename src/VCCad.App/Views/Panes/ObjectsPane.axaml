<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panes="clr-namespace:VCCad.App.Views.Panes"
             x:Class="VCCad.App.Views.Panes.ObjectsPane">
  <TreeView x:Name="ObjectTree" Margin="6" Height="240" SelectionMode="Multiple"
            SelectionChanged="OnTreeSelectionChanged">
    <TreeView.Styles>
      <Style Selector="TreeViewItem">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
      </Style>
    </TreeView.Styles>
    <TreeView.ItemTemplate>
      <TreeDataTemplate DataType="panes:ObjectNode" ItemsSource="{Binding Children}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                     Opacity="{Binding LabelOpacity}" TextTrimming="CharacterEllipsis"/>
          <ToggleButton Grid.Column="1" IsChecked="{Binding IsVisible, Mode=TwoWay}"
                        Padding="4,0" Background="Transparent" BorderThickness="0"
                        VerticalAlignment="Center">
            <Image Source="{Binding EyeSource}" Width="14" Height="14" Stretch="Uniform"/>
          </ToggleButton>
        </Grid>
      </TreeDataTemplate>
    </TreeView.ItemTemplate>
  </TreeView>
</UserControl>
