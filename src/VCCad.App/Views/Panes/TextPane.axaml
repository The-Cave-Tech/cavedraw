<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VCCad.App.Views.Panes.TextPane">
  <ScrollViewer>
    <StackPanel Margin="10,8" Spacing="8">
      <TextBlock Text="TEXT" FontWeight="SemiBold" FontSize="{DynamicResource VcFontSize}" Foreground="{DynamicResource VcTextDim}"/>

      <!-- What the fields below describe, and how many things that is. A panel editing a selection has to say which
           members it is describing rather than leaving a person to assume it is the first one. -->
      <TextBlock x:Name="SelectionLabel" TextWrapping="Wrap"
                 Foreground="{DynamicResource VcTextDim}" FontSize="{DynamicResource VcFontSize}"/>

      <!-- Which members the selection disagrees about. A field showing one block's value while the selection holds
           several is how a person edits believing it describes what they selected, so the disagreeing members are
           named here as well as being marked in place below. -->
      <TextBlock x:Name="MixedLabel" IsVisible="False" TextWrapping="Wrap"
                 Foreground="{DynamicResource VcTextDim}" FontSize="{DynamicResource VcFontSize}"/>

      <TextBlock Text="CONTENT" FontWeight="SemiBold" FontSize="{DynamicResource VcFontSize}" Foreground="{DynamicResource VcTextDim}"/>
      <TextBox x:Name="ContentBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"/>

      <TextBlock Text="COLOUR" FontWeight="SemiBold" FontSize="{DynamicResource VcFontSize}" Foreground="{DynamicResource VcTextDim}"/>

      <!-- The model holds one colour per block **and one of the run's own** (TextRun.Color, #161/#190). One field
           rather than four channels because a colour the selection disagrees about has no value to put in a channel:
           spelled out, "mixed" is a state a person can read and answer. The block colour paints every run that
           states none of its own; the run colour paints the inspected run and goes through `text.update`, the same
           operation `runColor` names, so a person and a driver set it the same way. -->
      <Grid ColumnDefinitions="Auto,*,10,Auto,*" ColumnSpacing="4">
        <TextBlock Text="Block" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
        <TextBox x:Name="ColorBox" Grid.Column="1" ToolTip.Tip="The block's colour, r,g,b,a in 0..255"/>
        <TextBlock Text="Run" Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
        <TextBox x:Name="RunColorBox" Grid.Column="4"
                 ToolTip.Tip="The inspected run's own colour, r,g,b,a in 0..255; empty draws it in the block's"/>
      </Grid>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
        <TextBlock Text="Align" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
        <ComboBox x:Name="AlignBox" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch">
          <ComboBoxItem Content="Left"/>
          <ComboBoxItem Content="Center"/>
          <ComboBoxItem Content="Right"/>
        </ComboBox>
      </Grid>

      <TextBlock Text="FACE" FontWeight="SemiBold" FontSize="{DynamicResource VcFontSize}" Foreground="{DynamicResource VcTextDim}"/>

      <!-- Which run of the block the face fields describe. Face is per run in this model, so with a multi-run block
           there is no such thing as "the font" and the pane has to say which run it is showing. -->
      <TextBlock x:Name="RunLabel" TextWrapping="Wrap"
                 Foreground="{DynamicResource VcTextDim}" FontSize="{DynamicResource VcFontSize}"/>

      <!-- Which face is actually drawn, asked of the resolver rather than assumed from the family name, plus the name
           the document itself asked for when the two differ. A substitution nobody is told about looks deliberate. -->
      <TextBlock x:Name="FontReport" IsVisible="False" TextWrapping="Wrap"
                 Foreground="{DynamicResource VcTextDim}" FontSize="{DynamicResource VcFontSize}"/>

      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
        <TextBlock Text="Font" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
        <ComboBox x:Name="FamilyBox" Grid.Column="1" HorizontalAlignment="Stretch"/>
      </Grid>
      <Grid ColumnDefinitions="Auto,*,10,Auto,*" ColumnSpacing="4">
        <TextBlock Text="Size" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
        <TextBox x:Name="SizeBox" Grid.Column="1"/>
        <CheckBox x:Name="BoldBox" Grid.Column="3" Content="Bold"/>
        <CheckBox x:Name="ItalicBox" Grid.Column="4" Content="Italic"/>
      </Grid>

      <!-- Tracking and word spacing are per run like the face, and the canvas, the caret and the exported page all
           already honour them (#147), so they are edited here through the same operation. -->
      <Grid ColumnDefinitions="Auto,*,10,Auto,*" ColumnSpacing="4">
        <TextBlock Text="Tracking" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
        <TextBox x:Name="LetterSpacingBox" Grid.Column="1"
                 ToolTip.Tip="Extra room after every glyph, in points; 0 is the face's own advances"/>
        <TextBlock Text="Word" Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
        <TextBox x:Name="WordSpacingBox" Grid.Column="4"
                 ToolTip.Tip="Extra room after each space, in points; 0 is the space's own advance"/>
      </Grid>

      <!-- A width and a variant are kept on the run and no face is chosen by them, so the value round-trips and is
           reported rather than changing the drawing. Type "normal" to put one back. -->
      <Grid ColumnDefinitions="Auto,*,10,Auto,*" ColumnSpacing="4">
        <TextBlock Text="Stretch" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
        <TextBox x:Name="FontStretchBox" Grid.Column="1"
                 ToolTip.Tip="font-stretch as CSS spells it - condensed, semi-expanded, 110%; normal clears it"/>
        <TextBlock Text="Variant" Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
        <TextBox x:Name="FontVariantBox" Grid.Column="4"
                 ToolTip.Tip="font-variant as CSS spells it - small-caps; normal clears it"/>
      </Grid>

      <!-- The quarter turn a glyph carries in a vertical column (#127): SVG's `glyph-orientation-vertical`, CSS's
           `text-orientation`. It is per run like the face, and the model already holds it while the layout turns every
           glyph by it - so it is edited here through `text.update`, the same operation the fields above use, and a
           driver sets it the same way. `mixed` is the initial value, and a horizontal block draws the same under all
           three. -->
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
        <TextBlock Text="Orient" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
        <ComboBox x:Name="OrientationBox" Grid.Column="1" HorizontalAlignment="Stretch"
                  ToolTip.Tip="text-orientation in a vertical column: mixed (turn the scripts that turn), upright (every glyph upright) or sideways (every glyph turned)">
          <ComboBoxItem Content="mixed"/>
          <ComboBoxItem Content="upright"/>
          <ComboBoxItem Content="sideways"/>
        </ComboBox>
      </Grid>

      <TextBlock Text="PARAGRAPH" FontWeight="SemiBold" FontSize="{DynamicResource VcFontSize}" Foreground="{DynamicResource VcTextDim}"/>
      <Grid ColumnDefinitions="Auto,*,10,Auto,*" ColumnSpacing="4">
        <TextBlock Text="Leading" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
        <TextBox x:Name="LeadingBox" Grid.Column="1"/>
        <TextBlock Text="Space" Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
        <TextBox x:Name="ParagraphBox" Grid.Column="4"/>
      </Grid>
      <Grid ColumnDefinitions="Auto,*,10,Auto,*" ColumnSpacing="4">
        <TextBlock Text="Turn" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
        <TextBox x:Name="RotationBox" Grid.Column="1" ToolTip.Tip="Degrees"/>
        <TextBlock Text="Frame" Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
        <TextBox x:Name="FrameWidthBox" Grid.Column="4" ToolTip.Tip="Wrap width in points; 0 means the block grows to fit"/>
      </Grid>

      <!-- The block's own axes and its base direction (#127). Both are layout, not labels: `vertical-rl` runs the pen
           down the block and stacks the line boxes sideways, and `rtl` puts the block's first character at its
           right-hand end and reorders the runs with the bidirectional algorithm. They go through `text.style`, the
           same operation the paragraph members above use, so a person and a driver set them the same way. -->
      <Grid ColumnDefinitions="Auto,*,10,Auto,*" ColumnSpacing="4">
        <TextBlock Text="Mode" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
        <ComboBox x:Name="WritingModeBox" Grid.Column="1" HorizontalAlignment="Stretch"
                  ToolTip.Tip="writing-mode: horizontal-tb, vertical-rl or vertical-lr">
          <ComboBoxItem Content="horizontal-tb"/>
          <ComboBoxItem Content="vertical-rl"/>
          <ComboBoxItem Content="vertical-lr"/>
        </ComboBox>
        <TextBlock Text="Direction" Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
        <ComboBox x:Name="DirectionBox" Grid.Column="4" HorizontalAlignment="Stretch"
                  ToolTip.Tip="direction: ltr or rtl - the block's base direction, not a per-run one">
          <ComboBoxItem Content="ltr"/>
          <ComboBoxItem Content="rtl"/>
        </ComboBox>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
