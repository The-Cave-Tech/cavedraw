<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VCCad.App.Views.Panes.StrokePane">
  <ScrollViewer>
    <StackPanel Margin="10,8" Spacing="8">
      <TextBlock Text="STROKE" FontWeight="SemiBold" FontSize="{DynamicResource VcFontSize}" Foreground="{DynamicResource VcTextDim}"/>

      <!-- Which stroke of the selection's stack the fields below describe, in the same words the appearance panel
           uses. With a stack there is no such thing as "the stroke", so the pane has to say which member it is
           showing rather than leaving a person to assume it is the top one. -->
      <TextBlock x:Name="StrokeTargetLabel" TextWrapping="Wrap"
                 Foreground="{DynamicResource VcTextDim}" FontSize="{DynamicResource VcFontSize}"/>

      <!-- Which members the selection disagrees about. A field that shows one path's number while the selection
           holds several is how a person types a value believing it describes what they selected, so the members
           that differ are named here as well as being marked in place below. -->
      <TextBlock x:Name="MixedLabel" IsVisible="False" TextWrapping="Wrap"
                 Foreground="{DynamicResource VcTextDim}" FontSize="{DynamicResource VcFontSize}"/>

      <Grid ColumnDefinitions="Auto,*,10,Auto,*">
        <TextBlock Text="Width" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
        <TextBox x:Name="StrokeWidthBox" Grid.Column="1"/>
        <TextBlock Text="Miter" Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
        <TextBox x:Name="MiterBox" Grid.Column="4"/>
      </Grid>
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Text="Cap" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
        <ComboBox x:Name="StrokeCapBox" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch">
          <ComboBoxItem Content="Butt"/>
          <ComboBoxItem Content="Round"/>
          <ComboBoxItem Content="Square"/>
        </ComboBox>
      </Grid>
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Text="Join" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
        <ComboBox x:Name="StrokeJoinBox" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch">
          <ComboBoxItem Content="Miter"/>
          <ComboBoxItem Content="Round"/>
          <ComboBoxItem Content="Bevel"/>
        </ComboBox>
      </Grid>
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Text="Dash" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
        <ComboBox x:Name="StrokeDashBox" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch">
          <ComboBoxItem Content="Solid"/>
          <ComboBoxItem Content="Dashed"/>
          <ComboBoxItem Content="Dotted"/>
          <ComboBoxItem Content="Dash-dot"/>
          <ComboBoxItem Content="Dash-dot-dot"/>
        </ComboBox>
      </Grid>
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Text="Align" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
        <ComboBox x:Name="StrokeAlignBox" Grid.Column="1" SelectedIndex="0" HorizontalAlignment="Stretch">
          <ComboBoxItem Content="Center"/>
          <ComboBoxItem Content="Inside"/>
          <ComboBoxItem Content="Outside"/>
        </ComboBox>
      </Grid>

      <TextBlock Text="TYPE" FontWeight="SemiBold" FontSize="{DynamicResource VcFontSize}"
                 Foreground="{DynamicResource VcTextDim}"/>

      <!-- The kind of stroke this is: a plain one, or one whose width varies along the path. The items are the
           document's own width profiles plus the stroke's, so a profile is offered here by existing rather than by
           being added to a list in this panel. -->
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Text="Stroke" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
        <ComboBox x:Name="StrokeTypeBox" Grid.Column="1" HorizontalAlignment="Stretch"
                  ToolTip.Tip="Plain, or a width profile the stroke carries"/>
      </Grid>

      <!-- Only when the inspected stroke has one: a profile readout over a stroke that has no profile would be
           chrome describing something that is not there. -->
      <StackPanel x:Name="ProfileSection" Spacing="2" IsVisible="False">
        <TextBlock x:Name="ProfileSummary" TextWrapping="Wrap"
                   Foreground="{DynamicResource VcText}" FontSize="{DynamicResource VcFontSize}"/>
        <TextBlock x:Name="ProfilePoints" TextWrapping="Wrap"
                   Foreground="{DynamicResource VcTextDim}" FontSize="{DynamicResource VcFontSize}"/>
      </StackPanel>

      <TextBlock Text="BRUSH" FontWeight="SemiBold" FontSize="{DynamicResource VcFontSize}"
                 Foreground="{DynamicResource VcTextDim}"/>

      <!-- The reusable brush this stroke is swept with. Brushes are assets in the document and a stroke names one,
           so this is a picker over the library rather than a number - and the items come from the document, so a
           brush created through brush.create is offered here by existing rather than by being listed in this file.
           Choosing one drives brush.apply and choosing "(none)" drives brush.clear, so the click and the call are
           one act on one model state. -->
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Text="Brush" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
        <ComboBox x:Name="StrokeBrushBox" Grid.Column="1" HorizontalAlignment="Stretch"
                  ToolTip.Tip="The reusable brush this stroke is swept with, from the document's library"/>
      </Grid>

      <!-- Only when there is one brush to describe: a readout over a stroke with no brush, or over a selection that
           disagrees about which one it carries, would be chrome describing something that is not agreed. -->
      <TextBlock x:Name="BrushSummary" IsVisible="False" TextWrapping="Wrap"
                 Foreground="{DynamicResource VcText}" FontSize="{DynamicResource VcFontSize}"/>

      <TextBlock Text="DYNAMICS" FontWeight="SemiBold" FontSize="{DynamicResource VcFontSize}"
                 Foreground="{DynamicResource VcTextDim}"/>

      <!-- What the stroke **records** about the pen that drew it, not what it looks like: what it looks like is the
           width profile above, which the pressure produced. A target the selection disagrees about reads mixed. -->
      <StackPanel x:Name="DynamicsRows" Spacing="2">
        <Grid ColumnDefinitions="Auto,*">
          <CheckBox x:Name="DynamicsWidthEnabled" Content="Width" MinWidth="112" VerticalAlignment="Center"
                    Foreground="{DynamicResource VcTextDim}" FontSize="{DynamicResource VcFontSize}"/>
          <ComboBox x:Name="DynamicsWidthCurve" Grid.Column="1" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="Linear"/>
            <ComboBoxItem Content="Soft"/>
            <ComboBoxItem Content="Hard"/>
            <ComboBoxItem Content="Exponential"/>
          </ComboBox>
        </Grid>
        <Grid ColumnDefinitions="Auto,*">
          <CheckBox x:Name="DynamicsOpacityEnabled" Content="Opacity" MinWidth="112" VerticalAlignment="Center"
                    Foreground="{DynamicResource VcTextDim}" FontSize="{DynamicResource VcFontSize}"/>
          <ComboBox x:Name="DynamicsOpacityCurve" Grid.Column="1" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="Linear"/>
            <ComboBoxItem Content="Soft"/>
            <ComboBoxItem Content="Hard"/>
            <ComboBoxItem Content="Exponential"/>
          </ComboBox>
        </Grid>
        <Grid ColumnDefinitions="Auto,*">
          <CheckBox x:Name="DynamicsScatterEnabled" Content="Scatter scale" MinWidth="112" VerticalAlignment="Center"
                    Foreground="{DynamicResource VcTextDim}" FontSize="{DynamicResource VcFontSize}"/>
          <ComboBox x:Name="DynamicsScatterCurve" Grid.Column="1" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="Linear"/>
            <ComboBoxItem Content="Soft"/>
            <ComboBoxItem Content="Hard"/>
            <ComboBoxItem Content="Exponential"/>
          </ComboBox>
        </Grid>
        <Grid ColumnDefinitions="Auto,*">
          <CheckBox x:Name="DynamicsAngleEnabled" Content="Nib angle" MinWidth="112" VerticalAlignment="Center"
                    Foreground="{DynamicResource VcTextDim}" FontSize="{DynamicResource VcFontSize}"/>
          <ComboBox x:Name="DynamicsAngleCurve" Grid.Column="1" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="Linear"/>
            <ComboBoxItem Content="Soft"/>
            <ComboBoxItem Content="Hard"/>
            <ComboBoxItem Content="Exponential"/>
          </ComboBox>
        </Grid>
        <Grid ColumnDefinitions="Auto,*">
          <CheckBox x:Name="DynamicsSmoothingEnabled" Content="Smoothing" MinWidth="112" VerticalAlignment="Center"
                    Foreground="{DynamicResource VcTextDim}" FontSize="{DynamicResource VcFontSize}"/>
          <ComboBox x:Name="DynamicsSmoothingCurve" Grid.Column="1" HorizontalAlignment="Stretch">
            <ComboBoxItem Content="Linear"/>
            <ComboBoxItem Content="Soft"/>
            <ComboBoxItem Content="Hard"/>
            <ComboBoxItem Content="Exponential"/>
          </ComboBox>
        </Grid>
      </StackPanel>

      <TextBlock Text="EFFECTS" FontWeight="SemiBold" FontSize="{DynamicResource VcFontSize}"
                 Foreground="{DynamicResource VcTextDim}"/>

      <!-- The order is the picture: roughen inside an offset is not an offset inside a roughen. So the list is a
           list, bottom of the stack first, and the buttons move the selected row within it. -->
      <ListBox x:Name="EffectList" Height="90" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*,Auto" Height="20">
              <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                         Foreground="{DynamicResource VcText}" FontSize="{DynamicResource VcFontSize}"/>
              <TextBlock Grid.Column="1" Text="{Binding Badge}" VerticalAlignment="Center"
                         Foreground="{DynamicResource VcTextDim}" FontSize="{DynamicResource VcFontSize}"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Grid ColumnDefinitions="*,Auto,Auto,*,*" ColumnSpacing="4">
        <!-- Filled from EffectRegistry, so every effect this build has is offered here by existing rather than by
             being added to a list in the panel. -->
        <ComboBox x:Name="EffectKindBox" Grid.Column="0" HorizontalAlignment="Stretch"
                  ToolTip.Tip="The effect to add, from the registry of what this build has"/>
        <Button x:Name="AddEffectButton" Grid.Column="1" Content="Add"/>
        <Button x:Name="RemoveEffectButton" Grid.Column="2" Content="Remove"/>
        <Button x:Name="MoveEffectUpButton" Grid.Column="3" Content="Up" HorizontalAlignment="Stretch"/>
        <Button x:Name="MoveEffectDownButton" Grid.Column="4" Content="Down" HorizontalAlignment="Stretch"/>
      </Grid>

      <!-- Built from the registry whenever a row is selected: one control per parameter the kind declares, so a new
           effect gets its editors by existing rather than by the panel knowing what it takes. -->
      <StackPanel x:Name="EffectParameters" Spacing="4"/>

      <!-- What the PDF export will leave out, from the same list the exporter is checked against. A person should
           learn it here rather than by opening the exported file and finding the effect missing. -->
      <TextBlock x:Name="ExportWarning" IsVisible="False" TextWrapping="Wrap"
                 Foreground="{DynamicResource VcTextDim}" FontSize="{DynamicResource VcFontSize}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
