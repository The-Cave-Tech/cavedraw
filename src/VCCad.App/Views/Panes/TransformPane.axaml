<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VCCad.App.Views.Panes.TransformPane">
  <ScrollViewer>
    <StackPanel Margin="8,6" Spacing="6">
      <!-- Reference point: nine circles on a square, left of the fields so the panel stays
           short. Affinity puts it in the same place and for the same reason. -->
      <Grid ColumnDefinitions="Auto,8,*">
        <ContentControl x:Name="PivotHost" Grid.Column="0" VerticalAlignment="Center"/>

        <!-- Two aligned columns of labelled fields: X/Y, W/H, R/S. Every box shows its unit,
             so a value reads as a measurement rather than a number. -->
        <Grid Grid.Column="2"
              ColumnDefinitions="14,*,10,14,*"
              RowDefinitions="Auto,Auto,Auto"
              ColumnSpacing="4" RowSpacing="4">
          <TextBlock Text="X" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
          <TextBox x:Name="XBox" Grid.Column="1" Height="24" Padding="4,0" KeyDown="OnFieldKeyDown" KeyboardNavigation.TabIndex="0"/>

          <TextBlock Text="W" Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
          <TextBox x:Name="WBox" Grid.Column="4" Height="24" Padding="4,0" KeyDown="OnFieldKeyDown" KeyboardNavigation.TabIndex="2"/>

          <TextBlock Text="Y" Grid.Row="1" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
          <TextBox x:Name="YBox" Grid.Row="1" Grid.Column="1" Height="24" Padding="4,0" KeyDown="OnFieldKeyDown" KeyboardNavigation.TabIndex="1"/>

          <TextBlock Text="H" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
          <TextBox x:Name="HBox" Grid.Row="1" Grid.Column="4" Height="24" Padding="4,0" KeyDown="OnFieldKeyDown" KeyboardNavigation.TabIndex="3"/>

          <TextBlock Text="R" Grid.Row="2" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
          <TextBox x:Name="AngleBox" Grid.Row="2" Grid.Column="1" Height="24" Padding="4,0" KeyDown="OnFieldKeyDown" KeyboardNavigation.TabIndex="4"/>

          <TextBlock Text="S" Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource VcTextDim}"/>
          <TextBox x:Name="SkewBox" Grid.Row="2" Grid.Column="4" Height="24" Padding="4,0" KeyDown="OnFieldKeyDown" KeyboardNavigation.TabIndex="5"/>
        </Grid>
      </Grid>

      <TextBlock x:Name="Hint" FontSize="10" Foreground="{DynamicResource VcTextDim}"
                 TextWrapping="Wrap"
                 Text="Type a measurement or a sum, e.g. 5.5in * 5 / 2"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
