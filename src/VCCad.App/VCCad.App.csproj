<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>VCCad.App</AssemblyName>
    <RootNamespace>VCCad.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>VCCad editor shell (Avalonia): windows-style menus/toolbars, docking panes and the pasteboard workspace. Consumed by the WebAssembly host.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <!-- The font chooser reads each family's real faces from the font index. Asking the
         renderer for a style a family does not have makes it build a synthetic one, and for
         at least one installed font that crashes the process natively. The index knows the
         faces, so the question never has to be asked. Same version Avalonia itself uses. -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.11" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../VCCad.Core/VCCad.Core.csproj" />
    <ProjectReference Include="../VCCad.Geometry/VCCad.Geometry.csproj" />
    <ProjectReference Include="../VCCad.Pdf/VCCad.Pdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The dock's drag arithmetic is worth testing on its own: it needs a laid-out grid to
         read row heights from, which a test can build but a pointer event cannot. -->
    <InternalsVisibleTo Include="VCCad.App.Tests" />
  </ItemGroup>

</Project>
