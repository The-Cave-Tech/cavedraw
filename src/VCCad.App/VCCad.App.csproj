<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>VCCad.App</AssemblyName>
    <RootNamespace>VCCad.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>VCCad editor shell (Avalonia): windows-style menus/toolbars, docking panes and the pasteboard workspace. Consumed by the WebAssembly host.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.11" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <!-- Bundle the same DejaVu faces the PDF exporter embeds, so on-canvas text
         metrics match the rendered/exported document. -->
    <AvaloniaResource Include="../VCCad.Pdf/Fonts/DejaVuSans.ttf" Link="Assets/Fonts/DejaVuSans.ttf" />
    <AvaloniaResource Include="../VCCad.Pdf/Fonts/DejaVuSans-Bold.ttf" Link="Assets/Fonts/DejaVuSans-Bold.ttf" />
    <AvaloniaResource Include="../VCCad.Pdf/Fonts/DejaVuSans-Oblique.ttf" Link="Assets/Fonts/DejaVuSans-Oblique.ttf" />
    <AvaloniaResource Include="../VCCad.Pdf/Fonts/DejaVuSerif.ttf" Link="Assets/Fonts/DejaVuSerif.ttf" />
    <AvaloniaResource Include="../VCCad.Pdf/Fonts/DejaVuSansMono.ttf" Link="Assets/Fonts/DejaVuSansMono.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../VCCad.Core/VCCad.Core.csproj" />
    <ProjectReference Include="../VCCad.Geometry/VCCad.Geometry.csproj" />
    <ProjectReference Include="../VCCad.Pdf/VCCad.Pdf.csproj" />
  </ItemGroup>

</Project>
